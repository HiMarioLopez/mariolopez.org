{
  "name": "mariolopez.org",
  "description": "Mario Lopez Martinez's personal website",
  "author": "Mario Lopez Martinez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiMarioLopez/mariolopez.org"
  },
  "homepage": "https://mariolopez.org",
  "keywords": [
    "personal website",
    "portfolio",
    "blog",
    "nextjs",
    "tailwindcss",
    "typescript",
    "react",
    "javascript",
    "html",
    "css",
    "git",
    "github",
    "vercel"
  ],
  "version": "1.0.0",
  "private": false,
  "scripts": {
    "build": "bun --bun next build",
    "dev": "bun --bun next dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "start": "bun --bun next start",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "check:i18n": "bun scripts/check-i18n.ts",
    "check:i18n:strict": "bun scripts/check-i18n.ts --strict",
    "check-links": "bun scripts/check-links.ts",
    "check-links:local": "bun scripts/check-links.ts --local",
    "check-links:prod": "bun scripts/check-links.ts --production",
    "prepare": "bun x husky"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.7.5",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@tanstack/react-query": "^5.90.21",
    "@upstash/redis": "^1.36.2",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "lucide-react": "^0.562.0",
    "negotiator": "^1.0.0",
    "next": "16.1.1",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@commitlint/types": "^20.4.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/ui": "^4.0.18",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "linkinator": "^7.5.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
